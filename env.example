# Placeholders only. Set real values in the host's dashboard; never commit them.

# Web service (RAILWAY_DOCKERFILE_PATH=Dockerfile): the live game. No login, no database, no secrets.
# PORT is set by the host. TRAIL_API_UPSTREAM and TRAIL_PROXY_KEY are no longer read.

# Old account server (RAILWAY_DOCKERFILE_PATH=Dockerfile.api): NOT used by the live game and
# unreachable from it. Listed only in case it is ever run again. See docs/accounts.md.
# DATABASE_URL=postgres://user:password@host:5432/database
# PG_POOL_MAX=5
# SESSION_SECRET=replace-with-at-least-32-random-characters
# AUDIT_PSEUDO_SECRET=replace-with-at-least-32-random-characters
# DISCORD_CLIENT_ID=your-discord-app-client-id
# DISCORD_CLIENT_SECRET=your-discord-app-client-secret
# PUBLIC_URL=https://your-game.example.com
# OWNER_DISCORD_ID=your-discord-user-id
# TRAIL_PROXY_KEY=replace-with-at-least-32-random-characters
# DISCORD_WEBHOOK_URL=
# TRAIL_API_ENABLED=1
# TRAIL_ALL_CHARS_DISCORD_IDS=
# TRAIL_SITE_DIR=
# PORT=8080
